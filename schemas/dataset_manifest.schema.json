{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MicroReasoner Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_type",
    "dataset_id",
    "build_timestamp",
    "seed",
    "inputs",
    "filters",
    "split_counts",
    "reject_stats",
    "artifact_paths",
    "artifact_hashes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dataset_type": {
      "type": "string",
      "enum": ["sft", "rl"]
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{8,64}$"
    },
    "build_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "adapter", "path", "resolved_path", "hash"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "adapter": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "resolved_path": {"type": "string", "minLength": 1},
          "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_think_tokens",
        "max_think_tokens",
        "require_single_boxed_answer",
        "drop_duplicates"
      ],
      "properties": {
        "min_think_tokens": {"type": "integer", "minimum": 0},
        "max_think_tokens": {"type": "integer", "minimum": 0},
        "require_single_boxed_answer": {"type": "boolean"},
        "drop_duplicates": {"type": "boolean"}
      }
    },
    "split_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "val"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "val": {"type": "integer", "minimum": 0}
      }
    },
    "reject_stats": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "artifact_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "val", "manifest"],
      "properties": {
        "train": {"type": "string", "minLength": 1},
        "val": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "minLength": 1},
        "rejects": {"type": "string", "minLength": 1}
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "val"],
      "properties": {
        "train": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "val": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rejects": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}

